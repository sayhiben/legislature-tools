# Copy this file to .env (or .env.local) and edit for your machine.
# Scripts under ./scripts/local and report runners load .env and .env.local automatically.

# Homebrew formulas used by setup (macOS + Linuxbrew)
BREW_PYTHON_FORMULA=python@3.12
BREW_POSTGRES_FORMULA=postgresql@17

# Local PostgreSQL settings (match docker-compose compatibility defaults)
DB_HOST=localhost
DB_PORT=55432
DB_NAME=legislature
DB_USER=legislature
DB_PASSWORD=legislature
EXPECTED_POSTGRES_MAJOR=17

# Local postgres data/log paths (relative paths resolve from testifier_audit/)
LOCAL_PGDATA=../output/postgres17-local
LOCAL_PGLOG=../output/postgres17-local/postgres.log

# Web server settings for local report browsing
LOCAL_WEB_HOST=127.0.0.1
LOCAL_WEB_PORT=8774
LOCAL_WEB_ROOT=../reports
LOCAL_WEB_PID_FILE=../output/local-web-server.pid
LOCAL_WEB_LOG_FILE=../output/local-web-server.log

# Default DB URL and Docker bypass for local operation
TESTIFIER_AUDIT_DB_URL=postgresql://legislature:legislature@localhost:55432/legislature
DATABASE_URL=postgresql://legislature:legislature@localhost:55432/legislature
TESTIFIER_AUDIT_SKIP_DOCKER_POSTGRES=1

# VRDB fetch URL (update monthly when WA SoS rotates the archive)
VRDB_URL=https://sos.wa.gov/_assets/elections/02.2026.WA.zip
